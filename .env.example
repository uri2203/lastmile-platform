# ==========================================================================
# Variables para docker-compose (copia este archivo a .env y rellena valores).
# .env NO se versiona (ver .gitignore). Aqui solo van los NOMBRES, sin valores.
# ==========================================================================

# --- PostgreSQL (servicio db) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- API Flask ---
# El backend lee FLASK_SECRET_KEY (no FLASK_SECRET).
FLASK_SECRET_KEY=

# DATABASE_URL se construye en docker-compose a partir de POSTGRES_USER/PASSWORD/DB.
# Si conectas a una BD externa (p.ej. Supabase), define DATABASE_URL directamente
# en el entorno del servicio api en su lugar.
