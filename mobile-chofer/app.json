{
  "expo": {
    "name": "Last Mile Chofer",
    "slug": "lastmile-chofer",
    "version": "1.0.3",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lastmiledelivery.chofer",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Se usa tu ubicacion para reportar tu posicion en tiempo real durante tus entregas.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Se usa tu ubicacion en segundo plano para que operaciones vea tu ruta mientras entregas pedidos.",
        "NSCameraUsageDescription": "Se usa la camara para tomar la foto de comprobante al entregar un pedido."
      },
      "backgroundModes": [
        "location"
      ]
    },
    "android": {
      "package": "com.lastmiledelivery.chofer",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d0d12"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Se usa tu ubicacion para reportar tu posicion en tiempo real durante tus entregas.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-camera",
      [
        "expo-notifications",
        {
          "color": "#6366f1"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#0d0d12"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4df972fa-2afa-4c48-887e-7e7245d2c379",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "extra": {
      "apiBaseUrl": "https://lastmile-platform.onrender.com",
      "eas": {
        "projectId": "4df972fa-2afa-4c48-887e-7e7245d2c379"
      }
    },
    "owner": "uri2203"
  }
}
