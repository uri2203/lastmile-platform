# ========================================
# LAST MILE DELIVERY - Environment Variables
# ========================================

# Database (PostgreSQL in production)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-secret-key
FLASK_ENV=development

# CORS (comma-separated origins, or * for all)
ALLOWED_ORIGINS=

# AI Service (Groq - free tier)
GROQ_API_KEYS=key1,key2,key3,key4

# ========================================
# PAYMENT PROCESSORS
# ========================================

# Stripe (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# MercadoPago (https://www.mercadopago.com.mx/developers)
MP_ACCESS_TOKEN=APP_USR-...
MP_PUBLIC_KEY=APP_USR-...
MP_WEBHOOK_SECRET=
MP_WEBHOOK_URL=https://your-domain.com/api/billing/webhook/mercadopago
MP_PLAN_STARTER=...
MP_PLAN_PRO=...
MP_PLAN_ENTERPRISE=...
