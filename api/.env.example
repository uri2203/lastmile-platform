# ========================================
# LAST MILE DELIVERY - Environment Variables
# ========================================

# Database (PostgreSQL in production)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-secret-key
FLASK_ENV=development

# CORS (comma-separated origins, or * for all)
ALLOWED_ORIGINS=

# AI Service (Groq - free tier)
GROQ_API_KEYS=key1,key2,key3,key4

# ========================================
# PAYMENT PROCESSORS
# ========================================
# Run: python stripe_setup.py to generate these values

# Stripe (https://dashboard.stripe.com)
# 1. Get API key from: Developers → API keys
# 2. Run stripe_setup.py to create Products/Prices
# 3. Webhook secret from: Developers → Webhooks → your endpoint → Signing secret
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# MercadoPago (https://www.mercadopago.com.mx/developers)
# Optional: Only needed if using MercadoPago instead of/alongside Stripe
MP_ACCESS_TOKEN=APP_USR-...
MP_PUBLIC_KEY=APP_USR-...
MP_WEBHOOK_SECRET=
MP_WEBHOOK_URL=https://your-domain.com/api/billing/webhook/mercadopago
MP_PLAN_STARTER=...
MP_PLAN_PRO=...
MP_PLAN_ENTERPRISE=...

# ========================================
# NOTIFICATIONS
# ========================================

# Email via Resend (https://resend.com)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Last Mile Delivery

# SMS via Twilio (https://www.twilio.com)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE=+1234567890

# WhatsApp Business API via Twilio (https://www.twilio.com/whatsapp)
# 1. Buy a WhatsApp-enabled number from Twilio
# 2. Join the Twilio WhatsApp Sandbox or get production access
# 3. Set the from number in format: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Base URL for tracking links
BASE_URL=https://lastmile-platform.onrender.com

# ========================================
# MONITORING
# ========================================
# Sentry (https://sentry.io) - recommended for production error tracking
SENTRY_DSN=

# ========================================
# PRODUCTION SUPERADMIN
# ========================================
# Set these env vars to auto-create superadmin on first boot
SUPERADMIN_USER=
SUPERADMIN_PASS=
